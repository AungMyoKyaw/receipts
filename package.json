{
  "name": "receipts",
  "version": "0.1.0",
  "description": "A local-first menu-bar time tracker. A proof of work, set in type.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "bun test tests",
    "test:timezones": "TZ=UTC bun test tests && TZ=America/New_York bun test tests && TZ=Asia/Yangon bun test tests",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "tauri": "tauri"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
